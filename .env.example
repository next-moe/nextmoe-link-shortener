# ============================================================================
# kungal-link-shortener local development environment (SHORTLINK_ prefix).
#
# Copy to .env and adjust. THIS FILE CARRIES PLACEHOLDER VALUES ONLY — never
# commit real credentials or platform secrets. .env is git-ignored;
# docker/compose.dev.yml and apps/api both read these values.
# ============================================================================

# ---- Backing-service ports exposed to the host by docker/compose.dev.yml ----
SHORTLINK_POSTGRES_PORT=7846
SHORTLINK_REDIS_PORT=7847

# ---- Postgres (docker/compose.dev.yml provisions this database) ----
SHORTLINK_POSTGRES_USER=shortlink
SHORTLINK_POSTGRES_PASSWORD=shortlink_dev_password
SHORTLINK_POSTGRES_DB=kun_shortlink

# ---- apps/api runtime (Go · Fiber · Huma) ----
SHORTLINK_HOST=0.0.0.0
SHORTLINK_PORT=7845
SHORTLINK_MODE=dev
# DSN targets the host-mapped Postgres port above; keep the password in sync
# with SHORTLINK_POSTGRES_PASSWORD.
SHORTLINK_DB_DSN=postgres://shortlink:shortlink_dev_password@localhost:7846/kun_shortlink?sslmode=disable

# Public base URL short links are advertised under (the dashboard and the S2S
# API build short URLs from it). In prod this is the site origin, e.g.
# https://s.kungal.com — the /s/<alias> redirect lives on the same origin.
SHORTLINK_PUBLIC_BASE_URL=http://127.0.0.1:7844

# Ecosystem roles allowed into the dashboard (comma-separated). The JWT roles
# claim (global ∪ site roles) is matched against this list.
SHORTLINK_ADMIN_ROLES=admin

# ---- NextMoe IdP (OIDC RP; this site is a standard RP via discovery) ----
# Issuer must serve /.well-known/openid-configuration; every endpoint is taken
# from that document (no path is hardcoded). Leave these empty to use the Dev
# header backdoor (`Authorization: Dev <user_id> [roles]`). Fill them in to log
# in through a real IdP — placeholders would make the API try discovery on
# every boot and stall. redirect_uri must match the web dev port (7844) and
# the value registered for this client at the IdP.
#
# SHORTLINK_OIDC_ISSUER=https://oauth.example.com
# SHORTLINK_OIDC_CLIENT_ID=your-client-id
# SHORTLINK_OIDC_CLIENT_SECRET=your-client-secret
SHORTLINK_OIDC_ISSUER=
SHORTLINK_OIDC_CLIENT_ID=
SHORTLINK_OIDC_CLIENT_SECRET=
SHORTLINK_OIDC_REDIRECT_URI=http://127.0.0.1:7844/auth/callback

# ---- Redis (BFF sessions; provisioned by compose.dev.yml) ----
SHORTLINK_REDIS_ADDR=localhost:7847
